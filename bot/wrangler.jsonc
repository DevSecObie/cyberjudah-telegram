{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberjudah-telegram",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // The Mini App lives at cyberjudah.io/app: the SPA under /app, the API it calls under
  // /api, and the verse-card images and frames under /card and /frames. The rest of the
  // apex (whatever the tunnel serves) is untouched; the webhook stays on workers.dev.
  "routes": ["cyberjudah.io/app*", "cyberjudah.io/api/*", "cyberjudah.io/card/*", "cyberjudah.io/frames/*", "cyberjudah.io/bs/*"],
  // The Mini App is a SPA staged by bot/scripts/prepare-assets.sh into .deploy/
  // (the build output at both / and /app/, so it loads on workers.dev and on
  // cyberjudah.io/app); every unknown path serves its index.html. The
  // API, the webhook and the verse cards are handled by the Worker before the assets.
  "assets": {
    "directory": "../.deploy",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The fork's pages (not its files) go through the Worker, so a deep link under /app/strong
    // gets the fork's own index.html instead of the current app's. /__scheduled reaches the
    // Worker so `wrangler dev --test-scheduled` (the end-to-end tests) can run the cron; a
    // deployed Worker has no such route and hands it to the assets like any unknown path.
    "run_worker_first": ["/api/*", "/webhook", "/__scheduled", "/card/*", "/frames/*", "/bs/*", "/app/strong", "/app/strong/*", "!/app/strong/_expo/*", "!/app/strong/assets/*"]
  },
  // search_docs (FTS5) loaded from the engine's search.sql.gz by scripts/load-search.mjs. The
  // id is filled in by the deploy workflow (scripts/d1-id.sh); nothing account-specific is committed.
  "d1_databases": [
    { "binding": "DB", "database_name": "cyberjudah-telegram", "database_id": "00000000-0000-0000-0000-000000000000" },
    // The site's database: teaching_passages and teaching_refs (the /teachings search and
    // "where was this chapter taught"), filled by the cyberjudah repository's workflows.
    { "binding": "TEACH", "database_name": "cyberjudah", "database_id": "11111111-1111-1111-1111-111111111111" }
  ],
  // Daily-verse subscriptions: sub:<userId> -> { chatId, hour, tz }.
  "kv_namespaces": [{ "binding": "SUBS", "id": "00000000000000000000000000000000" }],
  // Workers AI (embeddings, the answering model, the reading voices), the Vectorize index of
  // the teachings (scripts/embed.mjs fills it) and the R2 bucket that caches spoken chapters.
  // The deploy workflow creates the index and the bucket when they are missing.
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VEC", "index_name": "cyberjudah-teachings" }],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "cyberjudah-audio" }],
  // On the hour: the daily verse and the hourly jobs; every quarter hour: reading reminders
  // (so each reader's own time is reached in every time zone, including :30 and :45 offsets).
  "triggers": { "crons": ["0 * * * *", "15,30,45 * * * *"] },
  // Abuse protection for the reading-reminder endpoints (remind.ts): per caller, per minute.
  "ratelimits": [{ "name": "REMIND_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // Staging: the same code against separate resources, deployed by .github/workflows/stage.yml.
  // The staging bot is a second @BotFather bot; its token and webhook secret live in the
  // STAGING_BOT_TOKEN / STAGING_WEBHOOK_SECRET repository secrets. D1 "cyberjudah-telegram"
  // and the Vectorize index are the shared read-only data (staging never runs the embed);
  // the staging database and the SUBS-STAGING KV namespace are staging's own.
  "env": {
    "staging": {
      "name": "cyberjudah-telegram-staging",
      // Staging stays on workers.dev: the production cyberjudah.io routes above are not
      // inherited here on purpose (an empty routes list clears them for this environment).
      "routes": [],
      "d1_databases": [
        { "binding": "DB", "database_name": "cyberjudah-telegram-staging", "database_id": "00000000-0000-0000-0000-000000000000" },
        { "binding": "TEACH", "database_name": "cyberjudah", "database_id": "11111111-1111-1111-1111-111111111111" }
      ],
      "kv_namespaces": [{ "binding": "SUBS", "id": "00000000000000000000000000000000" }],
      "ratelimits": [{ "name": "REMIND_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }],
      // Environments do not inherit "vars": every production setting is repeated here (only
      // APP_URL differs). tests/wrangler.test.mjs fails if one goes missing.
      "vars": {
        "DATA_ORIGIN": "https://data.cyberjudah.io",
        "SITE_URL": "https://cyberjudah.io",
        "APP_URL": "https://t.me/STAGING_BOT_USERNAME/cybr",
        "CLAUDE_MODEL": "claude-opus-5", "LIVE_CHANNEL": "UC8gdvMmoqFOcx2N8YdjqRxw", "AI_GATEWAY": "default", "CLAUDE_BILLING": "cloudflare",
        "ASK_USD_PER_MTOK": "5", "ASK_USD_PER_STAR": "0.013", "ASK_MARGIN": "1.3",
        "ASK_FREE_DAILY": "120000", "ASK_PLAN_STARS": "750", "ASK_PACKS": "150,500,1500",
        "ASK_BILLING": "on", "ASK_BASIC_DAILY": "25"
      }
    }
  },
  // Secrets, set by the deploy workflow with `wrangler secret put`: BOT_TOKEN, WEBHOOK_SECRET,
  // APP_URL (the t.me link, once /newapp is done) and WORKER_URL (this Worker's public URL).
  "vars": {
    "DATA_ORIGIN": "https://data.cyberjudah.io",
    "SITE_URL": "https://cyberjudah.io",
    // The Mini App's direct link from @BotFather (/newapp). Shared links and buttons open the app.
    "APP_URL": "https://cyberjudah.io/app",
    // Ask CyberJudah's model when the ANTHROPIC_API_KEY secret is set (claude-sonnet-5 is the
    // cheaper choice; claude-opus-5 the strongest). Without the key, Llama 3.3 70B on Workers AI.
    "CLAUDE_MODEL": "claude-opus-5", "LIVE_CHANNEL": "UC8gdvMmoqFOcx2N8YdjqRxw",
    // Cloudflare AI Gateway for Workers AI calls (logs, analytics, rate limits on the dashboard).
    // "default" is created by Cloudflare on the first request (providers.ts). Claude goes through it
    // too once the CF_AIG_TOKEN secret is set; until then Claude is called directly. If Claude
    // fails, Ask answers with Workers AI (the backup) either way.
    "AI_GATEWAY": "default",
    // Who pays for Claude. "cloudflare": Unified Billing, from the Cloudflare account's AI Gateway
    // credits (AI → AI Gateway → Credits Available), with no Anthropic key sent; it needs the
    // CF_AIG_TOKEN secret, and until that is set the ANTHROPIC_API_KEY secret is used if present.
    // Anything else: the ANTHROPIC_API_KEY secret, billed by Anthropic. When the credits run
    // out, Ask answers with Workers AI (the backup) until they are topped up.
    "CLAUDE_BILLING": "cloudflare",
    // Ask CyberJudah's allowance. Each answer is measured in units (Claude's tokens, output
    // weighted five times input), and a Star buys ASK_USD_PER_STAR / ASK_USD_PER_MTOK * 1e6 /
    // ASK_MARGIN units, so every plan and pack pays for what it allows. Check ASK_USD_PER_MTOK
    // against Anthropic's price for the model's input tokens, and ASK_USD_PER_STAR against what
    // a Star brings in after Telegram's cut. ASK_FREE_DAILY is units free per person per day
    // (an average answer is about 60,000); /api/admin/usage shows the real averages.
    "ASK_USD_PER_MTOK": "5", "ASK_USD_PER_STAR": "0.013", "ASK_MARGIN": "1.3",
    "ASK_FREE_DAILY": "120000", "ASK_PLAN_STARS": "750", "ASK_PACKS": "150,500,1500",
    // "on": each reader gets ASK_FREE_DAILY units of in-depth (Claude) answers a day, then
    // ASK_BASIC_DAILY shorter answers (Workers AI, no charge) until the next UTC day, or pays
    // in Stars (plan or packs). Admins (ADMIN_IDS) are not limited. Off, every answer is still
    // measured for /api/admin/usage and the old cap of 100 a day applies.
    "ASK_BILLING": "on", "ASK_BASIC_DAILY": "25"
  }
}
