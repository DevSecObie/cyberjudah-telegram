{
  "name": "cyberjudah-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The CyberJudah Telegram bot and Mini App worker: serves the app, the Bot API webhook, search, sharing, Stars and the daily verse.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/fetch-dictionary.mjs && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "load-search": "node scripts/load-search.mjs",
    "load-transcripts": "node scripts/load-transcripts.mjs",
    "embed": "node scripts/embed.mjs",
    "fetch-dictionary": "node scripts/fetch-dictionary.mjs"
  },
  "dependencies": {
    "grammy": "^1.38.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250501.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.30.0"
  }
}
