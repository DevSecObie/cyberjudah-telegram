{
  "name": "cyberjudah-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The CyberJudah Telegram bot and Mini App worker: serves the app, the Bot API webhook, search, sharing, Stars and the daily verse.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/fetch-dictionary.mjs && bash scripts/prepare-assets.sh && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "load-search": "node scripts/load-search.mjs",
    "embed": "node scripts/embed.mjs",
    "fetch-dictionary": "node scripts/fetch-dictionary.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "entities": "^8.1.0",
    "grammy": "^1.38.0",
    "hono": "^4.9.0",
    "htmlparser2": "^12.0.0",
    "marked": "^16.4.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.30.0"
  }
}
