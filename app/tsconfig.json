{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "../shared/*.d.mts", "e2e/*.ts", "playwright.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@/*": ["./src/*"], "@shared/*": ["../shared/*"] }
  }
}
