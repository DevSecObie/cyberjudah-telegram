{
  "name": "cyberjudah-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs ../resources/*.test.mjs",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/final-captivity/build.mjs && node scripts/between-testaments/build.mjs",
    "pretest": "node scripts/final-captivity/build.mjs && node scripts/between-testaments/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "native:sync": "npm run build:native && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "native:icons": "node scripts/native-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@tanstack/react-query": "^5.104.3",
    "@telegram-apps/telegram-ui": "^2.1.13",
    "dompurify": "^3.4.17",
    "firebase": "13.0.0",
    "fuse.js": "^7.3.0",
    "idb": "^8.0.4",
    "lottie-web": "5.13.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "vaul": "1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  }
}
