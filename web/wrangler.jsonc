// The CyberJudah web app: the iPhone app's web export (DevSecObie/cyberjudah-app), static files
// only. It reads cyberjudah.io's API like the store app does. Deployed by .github/workflows/web.yml.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cyberjudah-web",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  // Each uploaded version gets its own workers.dev address, where web.yml checks it before the
  // switch. Cloudflare marks those addresses noindex.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "web.cyberjudah.io", "custom_domain": true }]
}
